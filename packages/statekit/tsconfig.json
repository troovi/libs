{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "ESNext",
    "baseUrl": "./",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "declaration": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "playground"],
  "exclude": ["node_modules", "dist"]
}
